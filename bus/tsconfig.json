{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"baseUrl": ".",
		"allowJs": false,
		"strict": true,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "./tsconfig.tsbuildinfo",
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
