<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  sessionbus broker — user LaunchAgent.

  Generated by `make launchd-install`, which substitutes absolute paths into
  broker/launchd/broker.plist.template and writes the result to
  ~/Library/LaunchAgents/. Regenerate with `make launchd-install` rather than
  editing this file by hand; `make launchd-uninstall` removes it.

  The node path below is absolute and therefore PINNED. If node is managed by
  nvm/fnm/homebrew, upgrading node moves the binary and this agent will fail to
  spawn — re-run `make launchd-install` after a node upgrade.

  This is a LaunchAgent (per-user, starts at login), NOT a LaunchDaemon. A
  LaunchDaemon runs as root at boot with HOME=/var/root, so the broker would
  bind a root-owned socket under /var/root/.claude/channels while Claude
  sessions — running as you — look in ~/.claude/channels. They would never
  meet. The broker must run as the same user as the sessions it serves.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__LABEL__</string>

	<!-- Must be --foreground: launchd supervises this process directly.
	     `broker start` would detach and exit, which launchd reads as a crash. -->
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__ENTRY__</string>
		<string>--foreground</string>
	</array>

	<!-- launchd starts an agent with no PATH of its own, so a child process gets only
	     /usr/bin:/bin:/usr/sbin:/sbin. The bridge resolves its appservice token by running the
	     command named in the config file, which typically lives in a package manager's bin
	     directory - unreachable from that default. The broker would then start, fail to read
	     the token, disable the bridge and keep serving local traffic: working by hand, silently
	     bridgeless at login. This PATH is generated by `make launchd-install` from the node and
	     token-command binaries actually found on the installing shell's PATH. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>CHANNELS_HOME</key>
		<string>__CHANNELS_HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<!-- Respawn on crash, but honour a clean shutdown: `broker stop` and
	     `launchctl bootout` exit 0, and SuccessfulExit=false means launchd
	     leaves it stopped rather than fighting you by restarting it. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>

	<key>WorkingDirectory</key>
	<string>__ROOT__</string>
</dict>
</plist>
